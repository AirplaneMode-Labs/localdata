# Every text file is stored and checked out with LF, on every platform. Tests compare fixture bytes
# (canonical JSON, golden reports, signatures) byte for byte, and a CRLF checkout on Windows breaks them.
* text=auto eol=lf

# Binary files are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.wasm binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary

# The vendored release tool, its record, the vendored release vectors and every SHA256SUMS are hashed or signed
# byte for byte: they are never converted (a CRLF checkout on Windows must not change a digest).
scripts/release/release-tool.mjs -text
scripts/release/VENDORED.json -text
scripts/release/vectors/** -text
SHA256SUMS -text
**/SHA256SUMS -text
*.sha256 -text
