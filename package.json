{
  "name": "@airplanemode/localdata",
  "version": "0.4.0-alpha.1",
  "description": "Offline-first browser storage SDK: set/get/delete over OPFS with an IndexedDB fallback, a flat vector index (putVectors/query) with an optional HNSW graph (buildIndex, query index \"hnsw\") and a WebAssembly scan, and a documents API (putDocument/queryChunks/deleteDocument).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AirplaneMode-Labs/localdata"
  },
  "homepage": "https://github.com/AirplaneMode-Labs/localdata",
  "bugs": {
    "url": "https://github.com/AirplaneMode-Labs/localdata/issues"
  },
  "keywords": [
    "browser",
    "documents",
    "hnsw",
    "indexeddb",
    "offline-first",
    "opfs",
    "storage",
    "vector-search",
    "webassembly"
  ],
  "scripts": {
    "build": "tsup --no-sourcemap",
    "build:harness": "node test/browser/serve.mjs --build-only",
    "demo:build": "node demo/build.mjs",
    "test": "vitest run",
    "test:browser": "playwright test -c test/browser/playwright.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "deps:scripts": "npm query ':attr(scripts,[postinstall]),:attr(scripts,[preinstall])'",
    "sync-contracts": "node scripts/sync-contracts.mjs",
    "ci": "npm run build:wasm && npm run fmt:check && npm run typecheck && npm run test && npm run build",
    "pack:check": "node scripts/pack-check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "fixture:tiny": "LDVEC_WRITE_FIXTURE=1 vitest run test/tiny-fixture.test.ts",
    "bench:vectors": "playwright test -c test/browser/playwright.bench.config.ts vector-bench",
    "bench:readme": "node scripts/bench-readme.mjs --write",
    "bench:documents": "playwright test -c test/browser/playwright.bench.config.ts documents-bench",
    "bench:docs-readme": "node scripts/bench-docs-readme.mjs --write",
    "bench:ann": "playwright test -c test/browser/playwright.bench.config.ts ann-bench",
    "bench:ann-readme": "node scripts/bench-ann-readme.mjs --write",
    "bench:delete-cost": "playwright test -c test/browser/playwright.bench.config.ts delete-cost",
    "bench:wasm-size": "node scripts/bench-wasm-size.mjs --write",
    "bench:check": "node scripts/bench-readme.mjs --check && node scripts/bench-docs-readme.mjs --check && node scripts/bench-ann-readme.mjs --check && node scripts/bench-wasm-size.mjs --check && node scripts/bench-figures.mjs",
    "release:rehearse": "node scripts/release/rehearse.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
